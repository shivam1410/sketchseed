<!--
  Adaptive icon foreground: a two-leaf sprout.

  Launchers mask the 108dp canvas down to a 72dp circle, so every extremity
  stays within ~34dp of the centre (54,54). The leaf tips are the binding
  constraint, which is why they reach diagonally rather than straight out.

  Mass sits in the leaves, not the stalk: at 48dp a thick stem reads as the
  subject and the leaves disappear. The veins are slim crescents filled in the
  background cream so they read as negative space, and both are kept clear of
  the leaf edges — a vein that breaks the outline looks like a rendering fault.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ── Stalk, forking left ─────────────────────────────────────────── -->

    <path
        android:pathData="M52,80 C52,71 52,64 54,57"
        android:strokeColor="#2F6B3E"
        android:strokeWidth="3.4"
        android:strokeLineCap="round" />
    <path
        android:pathData="M52,71 C50,67 49,63 50,59"
        android:strokeColor="#2F6B3E"
        android:strokeWidth="2.8"
        android:strokeLineCap="round" />

    <!-- ── Larger leaf, upper right ────────────────────────────────────── -->

    <path android:pathData="M54,56 C46,44 49,29 70,25 C75,42 69,53 54,56 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="70"
                android:startY="25"
                android:endX="54"
                android:endY="56"
                android:startColor="#96C757"
                android:endColor="#38723F" />
        </aapt:attr>
    </path>
    <path
        android:pathData="M56,52 C59,43 63,34 68,27 C64,38 60,46 56,52 Z"
        android:fillColor="#F7F1E4" />

    <!-- ── Smaller leaf, upper left ────────────────────────────────────── -->

    <path android:pathData="M51,59 C44,47 38,39 30,42 C34,54 42,58 51,59 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="30"
                android:startY="42"
                android:endX="51"
                android:endY="59"
                android:startColor="#8ABE4C"
                android:endColor="#31673A" />
        </aapt:attr>
    </path>
    <path
        android:pathData="M49,56 C45.5,51 41,46.5 35,43 C39.5,48.5 44.5,52.5 49,57 Z"
        android:fillColor="#F7F1E4" />
</vector>
