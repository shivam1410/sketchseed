<!--
  Themed-icon layer. Android tints this a single colour from the user's
  wallpaper, so it has to read as a silhouette: the colour separation between
  leaf, wood and graphite disappears entirely.

  Solid shapes only, with the leaves detached from the body by a small gap so
  the sprout stays legible once everything is one flat colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Black fills with no tint of our own: the system replaces the colour
         entirely, and a hardcoded tint here would fight it. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="1.06"
        android:scaleY="1.06">

        <!-- Stem -->
        <path
            android:pathData="M54,49 C54,43 54,38 54,32"
            android:strokeColor="#000000"
            android:strokeWidth="3.2"
            android:strokeLineCap="round" />

        <!-- Leaves, slightly detached so the sprout still reads once flat -->
        <path
            android:pathData="M55.5,37 C58,29 63.5,23.5 70,21.5 C70,30 65,36.5 55.5,37 Z"
            android:fillColor="#000000" />
        <path
            android:pathData="M52.5,44 C49,38.5 44.5,34.5 38.5,32.5 C39,39.5 44,43.5 52.5,44 Z"
            android:fillColor="#000000" />

        <!-- Pencil as one solid silhouette -->
        <path
            android:pathData="M42,47.5 H66 V68 L54,85 L42,68 Z"
            android:fillColor="#000000" />
    </group>
</vector>
