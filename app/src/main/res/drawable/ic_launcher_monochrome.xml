<!--
  Themed-icon layer. The system tints this a single colour from the user's
  wallpaper, so the gradients and cream veins are gone and the sprout has to
  survive as a flat silhouette.

  The veins become real holes, punched with the even-odd rule, rather than
  cream fills — otherwise each leaf collapses into a featureless blob. Black
  fills and no tint of our own: the system supplies the colour and a hardcoded
  tint would fight it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Stalk, forking left -->
    <path
        android:pathData="M52,80 C52,71 52,64 54,57"
        android:strokeColor="#000000"
        android:strokeWidth="3.4"
        android:strokeLineCap="round" />
    <path
        android:pathData="M52,71 C50,67 49,63 50,59"
        android:strokeColor="#000000"
        android:strokeWidth="2.8"
        android:strokeLineCap="round" />

    <!-- Leaves, each with its vein punched out -->
    <path
        android:fillType="evenOdd"
        android:fillColor="#000000"
        android:pathData="M54,56 C46,44 49,29 70,25 C75,42 69,53 54,56 Z
                          M56,52 C59,43 63,34 68,27 C64,38 60,46 56,52 Z" />
    <path
        android:fillType="evenOdd"
        android:fillColor="#000000"
        android:pathData="M51,59 C44,47 38,39 30,42 C34,54 42,58 51,59 Z
                          M49,56 C45.5,51 41,46.5 35,43 C39.5,48.5 44.5,52.5 49,57 Z" />
</vector>
