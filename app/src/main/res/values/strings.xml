    <string name="settings_backup_header">Google backup</string>
    <string name="settings_backup_explainer">Your journey, prompts, completion dates and streak are backed up to your Google account by Android and restored automatically when you set up a new phone. No sign-in needed.</string>
    <string name="settings_backup_images_title">Include sketch photos</string>
    <string name="settings_backup_images_summary">Photos count against the 25 MB app backup limit. Turn off to keep them on this device only.</string>
    <plurals name="settings_backup_storage">
        <item quantity="one">Sketches on device: %1$s across %2$d photo</item>
        <item quantity="other">Sketches on device: %1$s across %2$d photos</item>
    </plurals>
