<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Used by Google Drive backup and the update check, and by nothing else.
         The journey itself never talks to a server: no account, no sync, no
         analytics. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lets the app open the system installer for an update it downloaded.
         It only permits *asking*: Android still shows its own install screen and
         still refuses any APK not signed with this app's certificate. Granted by
         the user in system settings, never by a dialog. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Android 13+ asks the user before any notification can be posted. Denying
         it costs only the reminders; the rest of the app is unaffected. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- CAMERA is deliberately NOT declared. Sketch photos are taken by the
         user's own camera app via ACTION_IMAGE_CAPTURE, which needs no
         permission — but only while this app declares none. Declaring CAMERA
         here would make the platform start requiring it. -->

    <!-- Android Auto Backup is deliberately off. Its 25 MB quota silently drops
         data past the limit, it resets when the signing key changes, and it can
         neither be triggered nor inspected by the user. Google Drive backup
         replaces it, with an exportable zip as the escape hatch. -->
    <application
        android:allowBackup="false"
        android:name=".SketchSeedApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SketchSeed">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SketchSeed"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets the camera app write the captured photo into our cache. Only
             the capture directory is exposed; saved sketches stay private. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!--
          Re-anchors reminders when the wall clock moves. Neither action needs a
          permission, and neither is BOOT_COMPLETED — WorkManager restores its own
          jobs across a reboot. Not exported: only the system sends these.
        -->
        <!--
          Receives the installer session's replies, including the one that asks
          for the user's confirmation. Not exported: only the system sends these.
        -->
        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />

        <receiver
            android:name=".notify.ClockChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
