<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed so AICore can fetch the on-device Gemini Nano model. The app
         itself never talks to a server for the journey: no account, no sync,
         no analytics. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 13+ asks the user before any notification can be posted. Denying
         it costs only the reminders; the rest of the app is unaffected. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- CAMERA is deliberately NOT declared. Sketch photos are taken by the
         user's own camera app via ACTION_IMAGE_CAPTURE, which needs no
         permission — but only while this app declares none. Declaring CAMERA
         here would make the platform start requiring it. -->

    <!-- Android Auto Backup is deliberately off. Its 25 MB quota silently drops
         data past the limit, it resets when the signing key changes, and it can
         neither be triggered nor inspected by the user. Google Drive backup
         replaces it, with an exportable zip as the escape hatch. -->
    <application
        android:allowBackup="false"
        android:name=".SketchSeedApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SketchSeed">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SketchSeed"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets the camera app write the captured photo into our cache. Only
             the capture directory is exposed; saved sketches stay private. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
