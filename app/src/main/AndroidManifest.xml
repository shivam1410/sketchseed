<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed so Play Services can fetch the document-scanner module and so
         AICore can fetch the on-device Gemini Nano model. The app itself never
         talks to a server: there is no account, no sync, no analytics. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The ML Kit document scanner runs camera capture inside its own Play
         Services activity, so this app does not request CAMERA itself. -->

    <application
        android:name=".SketchSeedApplication"
        android:allowBackup="true"
        android:backupInForeground="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SketchSeed">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SketchSeed"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Download the document scanner module ahead of first use. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="docscanner" />
    </application>

</manifest>
